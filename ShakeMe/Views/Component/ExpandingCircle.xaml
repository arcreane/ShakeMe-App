<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShakeMe.Views.Component.ExpandingCircle"
             IsVisible="False"
             BackgroundColor="Transparent">

    <AbsoluteLayout x:Name="RootLayout" BackgroundColor="Transparent">
        <Frame x:Name="Circle"
               WidthRequest="100"
               HeightRequest="100"
               CornerRadius="50"
               HasShadow="False"
               IsClippedToBounds="True"
               Padding="0"
               Background="{StaticResource PrimaryRadialBrush}" />
    </AbsoluteLayout>
</ContentView>
