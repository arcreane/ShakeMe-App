<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShakeMe.Views.RegisterPage"
    Title="Inscription">

    <!-- Même arrière-plan dégradé que WelcomePage et LoginPage -->
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,1">
            <GradientStop Color="#667eea" Offset="0.0" />
            <GradientStop Color="#764ba2" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="CenterAndExpand">
            
            <!-- Logo et titre cohérents -->
            <VerticalStackLayout Spacing="10" Margin="0,0,0,20">
                <!-- Logo dans un cercle comme les autres pages -->
                <Frame BackgroundColor="White" 
                       CornerRadius="30" 
                       HasShadow="True"
                       WidthRequest="60" 
                       HeightRequest="60"
                       HorizontalOptions="Center"
                       Margin="0,0,0,15">
                    <Label Text="👋" 
                           FontSize="28" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"/>
                </Frame>

                <Label Text="ShakeMe" 
                       FontSize="32" 
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />
                <Label Text="Rejoins la communauté" 
                       FontSize="16" 
                       HorizontalOptions="Center"
                       TextColor="White"
                       Opacity="0.9"/>
            </VerticalStackLayout>

            <!-- Formulaire dans un Frame blanc -->
            <Frame BackgroundColor="White" 
                   CornerRadius="20" 
                   HasShadow="True"
                   Padding="25">
                
                <VerticalStackLayout Spacing="15">
                    
                    <!-- Champ Prénom -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Prénom"
                               Text="{Binding FirstName}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding FirstNameError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding FirstNameError}"
                           Margin="5,-10,0,0"/>

                    <!-- Champ Nom -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Nom"
                               Text="{Binding LastName}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding LastNameError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding LastNameError}"
                           Margin="5,-10,0,0"/>

                    <!-- Champ Pseudo -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Pseudo"
                               Text="{Binding Pseudo}"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding PseudoError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding PseudoError}"
                           Margin="5,-10,0,0"/>

                    <!-- Champ Email -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Email"
                               Text="{Binding Email}"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding EmailError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding EmailError}"
                           Margin="5,-10,0,0"/>

                    <!-- Champ Mot de passe -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Mot de passe"
                               Text="{Binding Password}"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding PasswordError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding PasswordError}"
                           Margin="5,-10,0,0"/>

                    <!-- Champ Confirmation mot de passe -->
                    <Frame BackgroundColor="#F8F9FA" 
                           CornerRadius="12"
                           HasShadow="False"
                           Padding="0"
                           BorderColor="#E9ECEF">
                        <Entry Placeholder="Confirme ton mot de passe"
                               Text="{Binding ConfirmPassword}"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#ADB5BD"
                               TextColor="#495057"
                               FontSize="16"
                               Margin="15,8" />
                    </Frame>
                    <Label Text="{Binding ConfirmPasswordError}" 
                           TextColor="#E74C3C" 
                           FontSize="12"
                           IsVisible="{Binding ConfirmPasswordError}"
                           Margin="5,-10,0,0"/>

                    <!-- Sélecteur de date de naissance -->
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Date de naissance" 
                               TextColor="#495057" 
                               FontSize="14"
                               FontAttributes="Bold"/>
                        <Frame BackgroundColor="#F8F9FA" 
                               CornerRadius="12"
                               HasShadow="False"
                               Padding="15,12"
                               BorderColor="#E9ECEF">
                            <DatePicker Date="{Binding DateOfBirth}"
                                        BackgroundColor="Transparent"
                                        TextColor="#495057"
                                        FontSize="16" />
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Bouton d'inscription avec le même style -->
                    <Button Text="S'inscrire"
                            Command="{Binding RegisterCommand}"
                            BackgroundColor="#667eea"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            Margin="0,20,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#667eea" 
                                    Opacity="0.3" 
                                    Radius="8" 
                                    Offset="0,4" />
                        </Button.Shadow>
                    </Button>

                    <!-- Lien vers la connexion -->
                    <StackLayout Orientation="Horizontal" 
                                 HorizontalOptions="Center" 
                                 Margin="0,20,0,0">
                        <Label Text="Déjà un compte ? " 
                               TextColor="#7F8C8D" 
                               FontSize="14" />
                        <Label Text="Se connecter" 
                               TextColor="#667eea" 
                               FontSize="14"
                               FontAttributes="Bold">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateToLoginCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                </VerticalStackLayout>
            </Frame>

            <!-- Footer cohérent avec les autres pages -->
            <VerticalStackLayout Spacing="5" Margin="0,20,0,0">
                <Label Text="Sécurisé par ShakeMe" 
                       FontSize="12" 
                       HorizontalOptions="Center"
                       TextColor="White"
                       Opacity="0.8" />
                <Label Text="Tes données sont protégées 🔒" 
                       FontSize="11" 
                       HorizontalOptions="Center"
                       TextColor="White"
                       Opacity="0.7" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>