<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:System="clr-namespace:System;assembly=System.Runtime"
    x:Class="ShakeMe.Views.RegisterPage"
    Title="Inscription">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry Placeholder="Prénom" Text="{Binding FirstName}" />
            <Entry Placeholder="Nom" Text="{Binding LastName}" />
            <Entry Placeholder="Pseudo" Text="{Binding Pseudo}" />
            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
            <Entry Placeholder="Mot de passe" Text="{Binding Password}" IsPassword="True" />
            <DatePicker Date="{Binding DateOfBirth}" MaximumDate="{x:Static Member=System:DateTime.Today}" />

            <Label 
                Text="{Binding ErrorMessage}" 
                TextColor="Red"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

            <Button Text="S'inscrire"
                    Command="{Binding RegisterCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>