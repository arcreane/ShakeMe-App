<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ShakeMe.Views.RegisterPage"
    Title="Inscription">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry Text="{Binding FirstName}" Placeholder="Prénom" />
            <Label Text="{Binding FirstNameError}" 
                   TextColor="Red" 
                   FontSize="12"
                   IsVisible="{Binding FirstNameError}" />


            <Entry Text="{Binding LastName}" Placeholder="Nom" />
            <Label Text="{Binding LastNameError}" TextColor="Red" FontSize="12" IsVisible="{Binding LastNameError}" />

            <Entry Text="{Binding Pseudo}" Placeholder="Pseudo" />
            <Label Text="{Binding PseudoError}" TextColor="Red" FontSize="12" IsVisible="{Binding PseudoError}" />
            
            <Entry Text="{Binding Email}" Placeholder="Email" />
            <Label Text="{Binding EmailError}" TextColor="Red" FontSize="12" IsVisible="{Binding EmailError}" />
            
            <Entry Text="{Binding Password}" Placeholder="Mot de passe" IsPassword="True" />
            <Label Text="{Binding PasswordError}" TextColor="Red" FontSize="12" IsVisible="{Binding PasswordError}" />
            
            <Entry Text="{Binding ConfirmPassword}" Placeholder="Confirme ton mot de passe" IsPassword="True" />
            <Label Text="{Binding ConfirmPasswordError}" TextColor="Red" FontSize="12" IsVisible="{Binding ConfirmPasswordError}" />
            
            <DatePicker Date="{Binding DateOfBirth}" />

            <Button Text="S'inscrire"
                    Command="{Binding RegisterCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>