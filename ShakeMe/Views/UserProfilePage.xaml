<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ShakeMe.Views.UserProfilePage"
             xmlns:viewmodels="clr-namespace:ShakeMe.ViewModels"
             x:DataType="viewmodels:UserProfileViewModel"
             Title="Mon profil">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="{Binding AvatarImageSource}"
                   WidthRequest="100"
                   HeightRequest="100"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding PickImageCommand}" />
                </Image.GestureRecognizers>
            </Image>


            <Label Text="Prénom" />
            <Entry Text="{Binding FirstName}" />

            <Label Text="Nom" />
            <Entry Text="{Binding LastName}" />

            <Label Text="Email" />
            <Entry Text="{Binding Email}" Keyboard="Email" />

            <Label Text="Pseudo" />
            <Entry Text="{Binding Pseudo}" />

            <Button Text="Enregistrer" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>