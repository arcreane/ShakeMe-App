<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:ShakeMe.Views"
       x:Class="ShakeMe.AppShell">

    <ShellContent Title="Welcome" ContentTemplate="{DataTemplate views:WelcomePage}" Route="WelcomePage" />
    <ShellContent Title="Register" ContentTemplate="{DataTemplate views:RegisterPage}" Route="RegisterPage" />
    <ShellContent Title="Login" ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />

</Shell>